# Copia este archivo como .env.local y completa los valores.
# En Vercel, estos mismos nombres van en Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: NUNCA la compartas ni la pegues en un chat.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública del sitio (sin / al final). Ej: https://puntocopete.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (correos con códigos). Si está vacío, el código se muestra en la
# consola del servidor (solo para pruebas).
RESEND_API_KEY=
EMAIL_FROM=Punto Copete <puntos@puntocopete.cl>
